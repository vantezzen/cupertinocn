  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "bun test",
    "registry:validate": "bun scripts/validate-registry.ts",
    "format": "prettier --write src/registry src/showcase src/App.tsx src/App.css src/index.css scripts tests docs README.md registry.json",
