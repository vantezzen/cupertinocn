  "items": [
    {
      "name": "cupertino-style",
      "type": "registry:ui",
      "title": "Cupertino styles",
      "description": "iOS tokens mapped onto the shadcn/ui theme variables, the Liquid Glass material, control geometry, motion, and accessible fallbacks.",
      "files": [
        {
          "path": "src/registry/ui/cupertino.css",
          "type": "registry:ui"
        }
      ],
      "registryDependencies": [],
      "cssVars": {
        "light": {
          "primary": "#0088ff",
          "primary-foreground": "#fff",
          "destructive": "#ff383c",
          "foreground": "#000",
          "muted": "#f2f2f7",
          "muted-foreground": "rgb(60 60 67 / 60%)",
          "border": "rgb(60 60 67 / 29%)",
          "card": "#fff",
          "card-foreground": "#000",
          "popover": "#fff",
          "popover-foreground": "#000",
          "secondary": "#f2f2f7",
          "secondary-foreground": "#000"
        },
        "dark": {
          "primary": "#0091ff",
          "primary-foreground": "#fff",
          "destructive": "#ff4245",
          "foreground": "#fff",
          "muted": "#000",
          "muted-foreground": "rgb(235 235 245 / 60%)",
          "border": "rgb(84 84 88 / 60%)",
          "card": "#1c1c1e",
          "card-foreground": "#fff",
          "popover": "#1c1c1e",
          "popover-foreground": "#fff",
          "secondary": "#1c1c1e",
          "secondary-foreground": "#fff"
        }
      }
    },
